{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "github-app-token-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "no_nodejs_als",
    "disallow_eval_during_startup",
    "global_fetch_strictly_public",
  ],
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "TOKEN_EXCHANGE_RATE_LIMIT",
      "namespace_id": "00000000000000000000000000000000",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY"],
  },
  "vars": {
    "GITHUB_API_BASE_URL": "https://api.github.com",
    "GITHUB_APP_ID": "000000",
    "TOKEN_BROKER_AUDIENCE": "https://cyspbot.chikachow.org",
  },
}

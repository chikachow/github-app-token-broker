{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "WebWorker"],
    "rootDir": ".",
    "types": ["@cloudflare/vitest-plugin/types", "@cloudflare/workers-types", "node"]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "workers/*/src/env.generated.d.ts"
  ],
  "exclude": ["**/dist"]
}
